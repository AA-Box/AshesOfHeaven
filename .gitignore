# Unreal Engine generated output
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Builds/
Build/Mac/FileOpenOrder/
**/__pycache__/

# A stubbed `unreal` makes unreal.Paths stringify into a literal directory name, and anything
# written under it lands here instead of Saved/. saved_path() in ImportAnimationDrop.py refuses
# that path outright; this catches any script that still builds one by hand.
MagicMock/

# Local PSO capture evidence can be large and is regenerated per RHI/driver run.
*.rec.upipelinecache
*.shk
*.utrace
*.stablepc.csv

# IDE and generated project metadata
.codex/
.cursor/
.gemini/
.vscode/
.vs/
.idea/
*.sln
*.suo
*.xcworkspace/
*.xcodeproj/xcuserdata/

# Local knowledge-graph output
graphify-out/

# OS files
.DS_Store

# Signing material and local credentials
*.p12
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
*.cer
*.pem
*.key

